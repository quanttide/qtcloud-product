  "maintainerThoughts": [
    {
      "id": "thought-1",
      "content": "规则引擎的扫描大家用得最多，AI 审查的接受度还不高，可能是误报率。先统计 AI 建议的采纳率再决定怎么调。",
      "author": "研发",
      "createdAt": "5月17日",
      "storyId": "code-story-4"
    },
    {
      "id": "thought-2",
      "content": "代码切片的提取目前只支持单文件，多文件调用链的切片才是重构时真正需要的。",
      "author": "产品经理",
      "createdAt": "5月20日",
      "storyId": "code-story-7"
    }
  ],
