  "eventStorm": {
    "id": "es-qtcloud-secret",
    "productId": "qtcloud-secret",
    "title": "机密传递 · 事件风暴",
    "description": "密码的安全传递与存储：渠道专用加密发送、接收方解密、全程审计。",
    "nodes": [
      {
        "id": "sender",
