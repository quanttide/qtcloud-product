        "id": "receiver",
        "type": "actor",
        "title": "接收者"
      },
      {
        "id": "cmd-submit",
        "type": "command",
        "title": "提交密码",
        "actorId": "sender"
      },
      {
        "id": "cmd-send",
        "type": "command",
        "title": "加密发送",
        "actorId": "sender"
      },
      {
        "id": "cmd-decrypt",
        "type": "command",
        "title": "解密查看",
        "actorId": "receiver"
      },
      {
        "id": "cmd-audit",
        "type": "command",
        "title": "执行审计",
        "actorId": "sender"
      },
