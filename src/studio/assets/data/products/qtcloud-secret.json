      {
        "id": "query-audit",
        "type": "queryModel",
        "title": "审计视图"
      },
      {
        "id": "evt-1",
        "type": "event",
        "title": "密码已提交",
        "order": 0,
        "commandId": "cmd-submit",
        "aggregateId": "agg-vault",
        "actorId": "sender"
      },
      {
        "id": "evt-2",
        "type": "event",
        "title": "渠道已加密发送",
        "order": 1,
        "commandId": "cmd-send",
        "aggregateId": "agg-vault",
        "externalSystemId": "ext-wechat",
        "policyIds": [
          "policy-channel"
        ],
        "actorId": "sender"
      },
      {
        "id": "evt-x1",
        "type": "event",
        "title": "渠道发送已失败",
        "order": 2,
        "commandId": "cmd-send",
        "aggregateId": "agg-vault",
        "externalSystemId": "ext-wechat",
        "actorId": "sender",
        "isException": true,
        "description": "渠道限流或凭证失效，发送失败，密码保持未发送状态。",
        "fromEventId": "evt-2"
      },
      {
        "id": "evt-3",
        "type": "event",
        "title": "接收方已解密",
        "order": 3,
        "commandId": "cmd-decrypt",
        "aggregateId": "agg-vault",
        "actorId": "receiver"
      },
      {
        "id": "evt-4",
        "type": "event",
        "title": "传递已审计",
        "order": 4,
        "commandId": "cmd-audit",
        "aggregateId": "agg-audit",
        "queryModelId": "query-audit",
