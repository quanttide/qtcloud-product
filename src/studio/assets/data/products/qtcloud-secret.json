  "maintainerThoughts": [
    {
      "id": "thought-1",
      "content": "密码传递的渠道稳定性是信任的基础，渠道发送失败必须降级到可见的提示，不能让用户以为发出去了。",
      "author": "安全",
      "createdAt": "5月16日",
      "storyId": "secret-story-1"
    },
    {
      "id": "thought-2",
      "content": "浏览器之间转换密码是高频刚需，但密码本之间转换大家还没理解价值，先把浏览器场景做透。",
      "author": "产品经理",
      "createdAt": "5月19日",
      "storyId": "secret-story-2"
    }
  ],
