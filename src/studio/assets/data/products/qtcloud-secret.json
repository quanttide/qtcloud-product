        "title": "审计日志"
      },
      {
        "id": "ext-wechat",
        "type": "externalSystem",
        "title": "微信渠道"
      },
      {
        "id": "policy-channel",
        "type": "policy",
        "title": "渠道专用：明文不得经聊天工具传递"
