    "nodes": [
      {
        "id": "admin",
        "type": "actor",
        "title": "管理员"
      },
      {
        "id": "cmd-register",
        "type": "command",
        "title": "注册产品",
        "actorId": "admin"
      },
      {
        "id": "cmd-configure",
        "type": "command",
        "title": "配置工作台",
        "actorId": "admin"
      },
      {
        "id": "cmd-sync",
        "type": "command",
        "title": "同步数据",
        "actorId": "admin"
      },
      {
        "id": "agg-registry",
        "type": "aggregate",
        "title": "产品注册表"
      },
      {
        "id": "query-overview",
