      },
      {
        "id": "evt-2",
        "type": "event",
        "title": "工作台已配置",
        "order": 1,
        "commandId": "cmd-configure",
        "aggregateId": "agg-registry",
        "actorId": "admin"
      },
      {
        "id": "evt-x1",
        "type": "event",
        "title": "同步已失败",
        "order": 2,
        "commandId": "cmd-sync",
        "aggregateId": "agg-registry",
        "actorId": "admin",
        "isException": true,
        "description": "数据源不可达或校验不通过，同步任务失败并重试。",
        "fromEventId": "evt-2"
      },
      {
        "id": "evt-3",
        "type": "event",
        "title": "数据已同步",
        "order": 3,
        "commandId": "cmd-sync",
        "aggregateId": "agg-registry",
        "queryModelId": "query-overview",
        "actorId": "admin"
      }
    ]
